# Copia este archivo a .env y completa los valores. NUNCA subas .env a GitHub.
PORT=3100
BASE_URL=http://localhost:3100
NODE_ENV=development

# Precios mensuales en COP (por defecto: estudiante 24.900, mentor 59.900)
PRECIO_ESTUDIANTE=24900
PRECIO_MENTOR=59900

# Administradores (correos separados por coma)
ADMIN_EMAILS=

# Wompi (mañana) — con llaves pub_test_… usa el sandbox
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# Solo desarrollo: aprobar pagos sin Wompi
PAGOS_SIMULADOS=0

# Supabase (cuando se conecte la base de datos)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# KYC (verificación de identidad con proveedor; Didit pendiente de conectar)
KYC_AUTO_APROBAR=1
# Solo desarrollo: simular resultados del proveedor
KYC_SIMULADO=0

# Didit (KYC): las tres variables activan el proveedor
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
